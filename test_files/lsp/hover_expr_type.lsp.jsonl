# Hover falls back to the Sema-resolved expression type: the literal `2`
# (0-based 7/30) -> "int". A position with nothing known (7 chars into the
# `fn main` line, no annotated node) -> null.
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"processId": null, "rootUri": "file://${ROOT}", "capabilities": {}}}}
{"wait_id": 1}
{"send": {"jsonrpc": "2.0", "method": "initialized", "params": {}}}
{"open": "test_files/lsp/src/hovers.b"}
{"wait_method": "textDocument/publishDiagnostics"}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://${ROOT}/test_files/lsp/src/hovers.b"}, "position": {"line": 7, "character": 30}}}}
{"wait_id": 2}
{"send": {"jsonrpc": "2.0", "id": 3, "method": "textDocument/hover", "params": {"textDocument": {"uri": "file://${ROOT}/test_files/lsp/src/hovers.b"}, "position": {"line": 5, "character": 7}}}}
{"wait_id": 3}
{"send": {"jsonrpc": "2.0", "id": 4, "method": "shutdown"}}
{"wait_id": 4}
{"send": {"jsonrpc": "2.0", "method": "exit"}}
{"expect_exit": 0}
