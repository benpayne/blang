# documentSymbol over a file with every category: struct Counter (fields
# count/step, method bump), enum Shape (three variants at their own U0c
# locations), protocol Sized (required method), two functions, and a test
# block. Also pins the null result for an unopened document.
{"send": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"processId": null, "rootUri": "file://${ROOT}", "capabilities": {}}}}
{"wait_id": 1}
{"send": {"jsonrpc": "2.0", "method": "initialized", "params": {}}}
{"open": "test_files/lsp/src/symbols.b"}
{"wait_method": "textDocument/publishDiagnostics"}
{"send": {"jsonrpc": "2.0", "id": 2, "method": "textDocument/documentSymbol", "params": {"textDocument": {"uri": "file://${ROOT}/test_files/lsp/src/symbols.b"}}}}
{"wait_id": 2}
{"send": {"jsonrpc": "2.0", "id": 3, "method": "textDocument/documentSymbol", "params": {"textDocument": {"uri": "file://${ROOT}/never_opened.b"}}}}
{"wait_id": 3}
{"send": {"jsonrpc": "2.0", "id": 4, "method": "shutdown"}}
{"wait_id": 4}
{"send": {"jsonrpc": "2.0", "method": "exit"}}
{"expect_exit": 0}
