{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "BLang",
	"scopeName": "source.blang",
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#annotations" },
		{ "include": "#strings" },
		{ "include": "#characters" },
		{ "include": "#numbers" },
		{ "include": "#keywords" },
		{ "include": "#types" },
		{ "include": "#constants" },
		{ "include": "#functions" },
		{ "include": "#operators" },
		{ "include": "#punctuation" }
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.blang",
					"match": "//.*$"
				},
				{
					"name": "comment.block.blang",
					"begin": "/\\*",
					"end": "\\*/",
					"patterns": [
						{
							"name": "comment.block.blang",
							"begin": "/\\*",
							"end": "\\*/"
						}
					]
				}
			]
		},
		"annotations": {
			"patterns": [
				{
					"name": "meta.annotation.blang",
					"match": "(@)(\\w+)(?:\\(([^)]*)\\))?",
					"captures": {
						"1": { "name": "punctuation.definition.annotation.blang" },
						"2": { "name": "storage.type.annotation.blang" },
						"3": { "name": "string.quoted.double.blang" }
					}
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.blang",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.blang",
							"match": "\\\\[nrt\\\\\"0]"
						},
						{
							"name": "meta.interpolation.blang",
							"begin": "\\{",
							"end": "\\}",
							"beginCaptures": {
								"0": { "name": "punctuation.section.interpolation.begin.blang" }
							},
							"endCaptures": {
								"0": { "name": "punctuation.section.interpolation.end.blang" }
							},
							"patterns": [
								{ "include": "#keywords" },
								{ "include": "#types" },
								{ "include": "#constants" },
								{ "include": "#numbers" },
								{ "include": "#operators" },
								{
									"name": "variable.other.blang",
									"match": "[a-zA-Z_][a-zA-Z0-9_]*"
								}
							]
						}
					]
				}
			]
		},
		"characters": {
			"patterns": [
				{
					"name": "string.quoted.single.blang",
					"match": "'(?:\\\\[nrt\\\\'0]|[^'\\\\])'"
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.hex.blang",
					"match": "\\b0[xX][0-9a-fA-F]+\\b"
				},
				{
					"name": "constant.numeric.binary.blang",
					"match": "\\b0[bB][01]+\\b"
				},
				{
					"name": "constant.numeric.float.blang",
					"match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
				},
				{
					"name": "constant.numeric.integer.blang",
					"match": "\\b[0-9]+\\b"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.blang",
					"match": "\\b(if|else|while|for|in|return|break|continue|match|spawn|async|await|on)\\b"
				},
				{
					"name": "keyword.declaration.blang",
					"match": "\\b(fn|struct|enum|protocol|impl|import|pub|extern|const|var|table|test)\\b"
				},
				{
					"name": "keyword.ownership.blang",
					"match": "\\b(own|shared|sync)\\b"
				},
				{
					"name": "keyword.contract.blang",
					"match": "\\b(requires|ensures|assert)\\b"
				},
				{
					"name": "keyword.query.blang",
					"match": "\\b(query|insert|update|delete|where|order_by|limit|first|set)\\b"
				},
				{
					"name": "keyword.channel.blang",
					"match": "\\b(chan)\\b"
				},
				{
					"name": "variable.language.blang",
					"match": "\\b(self)\\b"
				}
			]
		},
		"types": {
			"patterns": [
				{
					"name": "storage.type.primitive.blang",
					"match": "\\b(int|float|double|char|string|bool|long|short|void)\\b"
				},
				{
					"name": "storage.type.ffi.blang",
					"match": "\\b(cstring|carray)\\b"
				},
				{
					"name": "storage.type.generic.blang",
					"match": "\\b(Array|Map|Result|Option|Set)\\b"
				},
				{
					"comment": "User-defined type names (PascalCase identifiers)",
					"name": "entity.name.type.blang",
					"match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
				}
			]
		},
		"constants": {
			"patterns": [
				{
					"name": "constant.language.boolean.blang",
					"match": "\\b(true|false)\\b"
				},
				{
					"name": "constant.language.wildcard.blang",
					"match": "\\b_\\b"
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"comment": "Function definition: fn name",
					"match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
					"captures": {
						"1": { "name": "keyword.declaration.blang" },
						"2": { "name": "entity.name.function.blang" }
					}
				},
				{
					"comment": "Function call: name(",
					"match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
					"captures": {
						"1": { "name": "entity.name.function.call.blang" }
					}
				},
				{
					"comment": "Method call: .name(",
					"match": "(?<=\\.)([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
					"captures": {
						"1": { "name": "entity.name.function.method.blang" }
					}
				},
				{
					"comment": "Test block: test \"name\"",
					"match": "\\b(test)\\s+(\"[^\"]*\")",
					"captures": {
						"1": { "name": "keyword.declaration.blang" },
						"2": { "name": "string.quoted.double.blang" }
					}
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.pipeline.blang",
					"match": "\\|>"
				},
				{
					"name": "keyword.operator.arrow.blang",
					"match": "->"
				},
				{
					"name": "keyword.operator.range.blang",
					"match": "\\.\\."
				},
				{
					"name": "keyword.operator.try.blang",
					"match": "\\?"
				},
				{
					"name": "keyword.operator.comparison.blang",
					"match": "==|!=|<=|>=|<|>"
				},
				{
					"name": "keyword.operator.logical.blang",
					"match": "&&|\\|\\||!"
				},
				{
					"name": "keyword.operator.assignment.blang",
					"match": "\\+=|-=|\\*=|/=|%=|\\^=|="
				},
				{
					"name": "keyword.operator.arithmetic.blang",
					"match": "\\+|-|\\*|/|%"
				},
				{
					"name": "keyword.operator.bitwise.blang",
					"match": "<<|>>|&|\\||\\^|~"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.separator.blang",
					"match": "[;,]"
				},
				{
					"name": "punctuation.accessor.blang",
					"match": "\\."
				}
			]
		}
	}
}
